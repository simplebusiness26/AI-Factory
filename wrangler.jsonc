{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-factory",
  "main": "src/worker-v2.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "OS_URL": "https://personal-operating-system.simplebussiness26.workers.dev"
  },
  "secrets": {
    "required": ["AI_FACTORY_KEY", "GITHUB_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
