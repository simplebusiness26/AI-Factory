# Optional but recommended. Required for private repositories and richer GitHub status.
GITHUB_TOKEN=

# Existing write protection for Project Brain. The orchestration wrapper can reuse this
# when FACTORY_WRITE_TOKEN is not set.
AI_FACTORY_KEY=

# Operating System -> AI Factory. Set this to the same value as the OS FACTORY_WRITE_TOKEN.
FACTORY_WRITE_TOKEN=

# AI Factory -> Operating System result callback.
OS_RESULT_URL=https://your-operating-system.workers.dev/api/integrations/factory/results
OS_RESULT_TOKEN=

PORT=3000
HOST=0.0.0.0
GITHUB_CACHE_TTL_MS=120000
